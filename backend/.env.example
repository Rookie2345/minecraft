# Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Frontend CORS Origin (comma-separated for multiple origins, or * for all in development)
FRONTEND_URL=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500

# Neon PostgreSQL Database Connection String
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT Secret for Admin Authentication (use a long, random string in production)
JWT_SECRET=replace_with_a_long_random_secret_key_minimum_32_characters

# Default Admin Seed Credentials (used only if no admin exists in the database on startup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!

# Cloudflare R2 Object Storage (S3-compatible)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=minecraft-storage
# Optional: R2 public URL if public bucket access is enabled
R2_PUBLIC_URL=
